{
  "name": "@teckin/climber",
  "version": "0.0.0",
  "private": true,
  "description": "Cogspire, the vertical climbing race: rules, energy, summits, maps and theme packs.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client/index.ts",
    "./package.json": "./package.json",
    "./maps/course.json": "./maps/course.json",
    "./server": "./src/server/index.ts",
    "./protocol": "./src/protocol.ts"
  },
  "scripts": {
    "build": "tsx scripts/build-art.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "generate:course": "tsx scripts/generate-course.ts",
    "playtest": "tsx scripts/playtest.ts"
  },
  "dependencies": {
    "@colyseus/core": "0.18.18",
    "@colyseus/schema": "5.0.36",
    "@teckin/engine-core": "workspace:*",
    "@teckin/game-contracts": "workspace:*",
    "@teckin/platformer-kit": "workspace:*",
    "@teckin/room-core": "workspace:*",
    "phaser": "4.2.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@colyseus/sdk": "0.18.5",
    "@colyseus/testing": "0.18.6",
    "@teckin/config": "workspace:*",
    "@teckin/questions": "workspace:*",
    "@teckin/session": "workspace:*",
    "@types/node": "22.20.5",
    "eslint": "10.12.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
