{
  "name": "web",
  "version": "0.0.0",
  "private": true,
  "description": "Next.js web app: site, host dashboard, join and play pages.",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-game-assets.mjs",
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "prebuild": "node scripts/copy-game-assets.mjs",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 3000",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@teckin/climber": "workspace:*",
    "@teckin/engine-core": "workspace:*",
    "@teckin/game-contracts": "workspace:*",
    "@teckin/ui": "workspace:*",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@teckin/config": "workspace:*",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.12.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
