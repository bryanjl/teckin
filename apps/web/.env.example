# Theme pack for the Climber game (a folder name in games/climber/themes). Optional;
# defaults to the game's own default theme. `?theme=<id>` overrides it for previews.
NEXT_PUBLIC_CLIMBER_THEME=cogspire

# --- Database (Phase 4) ---
# Matches the postgres service in docker-compose.yml. Apply migrations with `pnpm --filter @teckin/db db:migrate`.
DATABASE_URL=postgresql://teckin:teckin-local@localhost:5432/teckin

# --- Host sign-in (Auth.js) ---
# Signs session cookies. Generate one with `npx auth secret` or `openssl rand -base64 33`; never commit it.
AUTH_SECRET=replace-with-a-long-random-string
# The site's public address when deployed (e.g. https://teckin.example.org). Not needed locally.
# AUTH_URL=

# Magic-link email. With EMAIL_SERVER unset, `next dev` prints sign-in links to the server log.
# Deployed: the SMTP relay of Azure Communication Services Email, e.g.
# smtp://<username>:<password>@smtp.azurecomm.net:587
# EMAIL_SERVER=
# EMAIL_FROM=Teckin <sign-in@your-domain.example>
# A production build (`next start`) logs links only when this is true. Never set it when deployed.
# AUTH_LOG_MAGIC_LINKS=false
# Local tests only: also write each logged link to a file in this folder.
# AUTH_DEV_MAILBOX_DIR=

# Sign-in attempts allowed per 15 minutes from one network address (a school shares one) and
# per email address. Defaults: 30 and 5.
# SIGN_IN_LIMIT_PER_ADDRESS=30
# SIGN_IN_LIMIT_PER_EMAIL=5

# Google and Microsoft sign-in appear only when both their id and secret are set.
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# AUTH_MICROSOFT_ENTRA_ID_ID=
# AUTH_MICROSOFT_ENTRA_ID_SECRET=
# Leave unset to accept any Microsoft account; set to https://login.microsoftonline.com/<tenant id>/v2.0 for one tenant.
# AUTH_MICROSOFT_ENTRA_ID_ISSUER=

# --- Launching games (the realtime server) ---
# The same value as REALTIME_SHARED_SECRET in apps/realtime/.env, at least 32 characters.
# Generate one with `openssl rand -base64 33`; never commit it.
REALTIME_SHARED_SECRET=replace-with-the-same-long-random-string-as-the-web-app
# How this server reaches the realtime server. Defaults to NEXT_PUBLIC_REALTIME_URL, then
# http://127.0.0.1:2567 (local development).
# REALTIME_INTERNAL_URL=
