{
  "name": "realtime",
  "version": "0.0.0",
  "private": true,
  "description": "Colyseus realtime server: registers each game room and serves health, join-code lookup and dev game creation.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "start": "tsx --env-file-if-exists=.env src/main.ts",
    "build": "node scripts/bundle.mjs",
    "start:bundle": "node --enable-source-maps dist/main.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "load-test": "tsx scripts/load-test.ts"
  },
  "dependencies": {
    "@colyseus/core": "0.18.18",
    "@colyseus/redis-driver": "0.18.4",
    "@colyseus/redis-presence": "0.18.5",
    "@colyseus/ws-transport": "0.18.4",
    "@teckin/climber": "workspace:*",
    "@teckin/game-contracts": "workspace:*",
    "@teckin/nicknames": "workspace:*",
    "@teckin/questions": "workspace:*",
    "@teckin/room-core": "workspace:*",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@colyseus/sdk": "0.18.5",
    "@colyseus/testing": "0.18.6",
    "@teckin/config": "workspace:*",
    "@teckin/session": "workspace:*",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
