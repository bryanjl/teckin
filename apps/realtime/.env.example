# Port the realtime server listens on.
REALTIME_PORT=2567
# Interface to bind. 0.0.0.0 lets phones on the local network connect.
REALTIME_HOST=0.0.0.0
# Redis for presence, join codes and matchmaking across processes. Leave empty for a single
# in-memory process. With docker compose: redis://localhost:6379
REDIS_URL=
# Secret the temporary /dev/new-game page sends to create games. Empty switches it off.
# Use any long random string locally; never reuse it anywhere else.
DEV_GAME_SECRET=change-me-to-a-long-random-string
# Public address of this process when several run behind separate addresses (see docs/DECISIONS.md).
REALTIME_PUBLIC_ADDRESS=
# 1 serves GET /metrics/load (room tick time, CPU, memory) for the load test. Leave off otherwise.
REALTIME_LOAD_METRICS=
