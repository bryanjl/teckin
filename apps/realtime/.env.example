# Port the realtime server listens on.
REALTIME_PORT=2567
# Interface to bind. 0.0.0.0 lets phones on the local network connect.
REALTIME_HOST=0.0.0.0
# Redis for presence, join codes and matchmaking across processes. Leave empty for a single
# in-memory process. With docker compose: redis://localhost:6379
REDIS_URL=
# Secret shared with the web app (the same value as REALTIME_SHARED_SECRET in apps/web/.env),
# at least 32 characters. It checks the web app's game launches and signed-in hosts' passes;
# empty means no game can be launched. Generate one with `openssl rand -base64 33`.
REALTIME_SHARED_SECRET=replace-with-the-same-long-random-string-as-the-web-app
# The web app's database. With it, launched games are recorded (players, answers, results) for
# reports, and the data retention job runs every 6 hours. Without it nothing is stored.
DATABASE_URL=postgresql://teckin:teckin-local@localhost:5432/teckin
# Months players' answers are kept before the retention job deletes them. Default 12.
PLAYER_DATA_RETENTION_MONTHS=12
# Public address of this process when several run behind separate addresses (see docs/DECISIONS.md).
REALTIME_PUBLIC_ADDRESS=
# 1 serves GET /metrics/load (room tick time, CPU, memory) for the load test. Leave off otherwise.
REALTIME_LOAD_METRICS=
